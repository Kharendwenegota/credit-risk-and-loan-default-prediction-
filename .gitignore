# Data files - never commit raw/processed data
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Models (usually large binary files)
outputs/models/*.pkl
outputs/models/*.joblib
!outputs/models/.gitkeep

# OS/Editor
.DS_Store
.vscode/settings.json

# Kaggle credentials
kaggle.json